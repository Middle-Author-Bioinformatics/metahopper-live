{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyProjectReports",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "reports/phoridae/",
            "reports/phoridae/*",
            "reports/aphrophora/",
            "reports/aphrophora/*",
            "reports/sample-reports/",
            "reports/sample-reports/*"
          ]
        }
      }
    },
    {
      "Sid": "PublishProjectReports",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/reports/phoridae/*",
        "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/reports/aphrophora/*",
        "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/reports/sample-reports/*"
      ]
    }
  ]
}
